SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here
SPOTIFY_REDIRECT_URI=http://YOUR_SERVER_IP:8080/callback
NAVIDROME_URL=http://192.168.1.100:4533
NAVIDROME_USER=admin
NAVIDROME_PASSWORD=your_navidrome_password
SSH_HOST=192.168.1.100
SSH_USER=root
SSH_PORT=22
SSH_MUSIC_PATH=/opt/navidrome/music
# Discover's own folder (its own Navidrome library) is found automatically: /opt/navidrome/discover,
# or inside Navidrome's data folder when Navidrome runs in Docker. Only set these to choose it yourself:
# the folder on the Navidrome host, and the same folder as Navidrome sees it (inside its container).
# DISCOVER_MUSIC_PATH=
# DISCOVER_NAVIDROME_PATH=
# Optional: max seconds for a whole-library scan (Library Maintenance). Raise it for a big or slow library (e.g. on a NAS).
# REMOTE_SCAN_TIMEOUT=3600
